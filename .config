<?php declare (strict_types=1);

if (!defined ('basepath'))
{
    $heading = 'Internal System Error';
    $message = 'An unexpected error occurred. Please contact the Administrator.';
    http_response_code (500);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>{$heading}</h1><p>{$message}</p>");
}

unset ($call, $lock_as, $is_locked_as);

$dirs = [
    'systemf'    => $system_folder ?? 'src',
    'appf'       => $application_folder ?? 'apps',
];

include_once call_user_func ('implode', '.', [basepath, 'supports']);

if (!is_callable ('interlace'))
{
    throw new Exception ("Failed to call supports library", 1);
}

foreach ($dirs as $type => $dir)
{
    if (!defined ($type))
    {
        $nskey = substr ($type, 0, 3);
        define ($type, interlace (basepath, $dir));
        define ("ns{$nskey}", ucfirst (substr ($type, 0, -1)));
    }
}

include_once call_user_func ('implode', '.', [basepath, 'structures']);

if (!defined ('modulesfapp'))
{
    throw new Exception ("Failed to register core structures", 1);
}

// $kernel_directory = 'Kernel';
// $lock_as ('nskernel', namespacify (interlace (nssys, $kernel_directory)));
// $lock_as ('kernel', interlace (systemf, $kernel_directory));
$boot_key = interlace (kernelf, 'Boot.php');

if (!is_readable ($boot_key))
{
    throw new Exception ("Missing boot key");
}

require_once interlace (kernelf, 'Boot.php');
$boot = namespacify (interlace (nskernel, 'Boot'));

if (!class_exists ($boot, false))
{
    throw new Exception ("Failed to prepared boot sequence");
}