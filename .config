<?php declare (strict_types=1);

/**
 * Configuration Loader
 * --
 * Maps folder names to namespace roots and hands off to the kernel. Reads the directory structure
 * defined at runtime (apps, src, modules), registers each as a path constant with its corresponding
 * namespace prefix, then verifies the framework core (`src/Kernel/Boot.php`) is present and
 * loadable. This is the bridge between project layout and executable code.
 *
 * @package     NanoRADF
 * @author      RADLabs Development Team
 * @copyright   Radlabs Studio (c) 1986 - 2026
 * @since       0.0.1
 */

namespace System;

use Throwable;
use Exception;
// use function System\interlace;
// use function System\fl;
// use function System\namespacify;

if (!defined ('basepath'))
{
    try {exit (@require realpath (__DIR__).DIRECTORY_SEPARATOR.'.errors');}
    catch (Throwable $e) {$file = basename (__FILE__); exit ("404 Forbidden {$file}");}
}

// Source roots from the entry file (fallback: apps/, modules/, src/).
$dirs = [
    'appf'       => $application_folder ?? 'apps',
    'modulesf'   => $modules_folder ?? 'modules',
    'systemf'    => $system_folder ?? 'src',
];

// Drop entry locals; only constants survive bootstrap.
unset ($call, $lock_as, $is_locked_as, $system_folder, $application_folder, $modules_folder);

// Path constants — normally defined by .starter; fallback for direct includes.
if (!defined ('sep'))
{
    define ('sep', DIRECTORY_SEPARATOR);
    define ('basepath', realpath (__DIR__).sep);
    define ('publicpath', realpath (getcwd ()).sep);
}

foreach ($dirs as $type => $dir)
{
    if (!defined ($type))
    {
        // Root namespaces: System\, App\, Modules\ (modules are their own root).
        $nskey = substr ($type, 0, 3);
        define ($type, interlace (basepath, $dir));
        define ("ns{$nskey}", ucfirst (substr ($type, 0, -1)."\\"));
    }

    else {continue;}
}

require_file (interlace (basepath, fl ('structures', false)), 'structure');

$bootable_key = 'Boot';
$init = 'initiate';

require_file (interlace (kernelf, fl ($bootable_key)), 'boot');

$kernel = namespacify (interlace (nskernel, $bootable_key));
unset ($bootable_file, $bootable_key);

if (!class_exists ($kernel, false)) {throw new Exception ('kernel', 500);}
elseif (!method_exists ($kernel, $init)) {throw new Exception ('init', 500);}

call_user_func ([$kernel, $init]);
unset ($kernel, $init);
