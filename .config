<?php declare (strict_types=1);

/**
 * Bootstrap — source roots, structures, kernel hand-off.
 *
 * Resolves the three roots (apps/, modules/, src/) with their PSR-4
 * namespace prefixes, loads `.structures`, then requires and verifies
 * the Boot class. Joins the `$error` sentinel chain started in
 * `.starter`: on failure it sets 'structure', 'boot', or 'kernel'
 * and skips the remaining stages; the gateway switch reports it.
 *
 * @since 0.0.1
 */

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

// Source roots from the entry file (fallback: apps/, modules/, src/).
$dirs = [
    'appf'       => $application_folder ?? 'apps',
    'modulesf'   => $modules_folder ?? 'modules',
    'systemf'    => $system_folder ?? 'src',
];

// Drop entry locals; only constants survive bootstrap. `$debug` is re-set from
// the entry variable below and kept for the gateway's error disclosure gate.
unset ($call, $lock_as, $is_locked_as, $system_folder, $application_folder, $modules_folder);
$debug ??= false;

// Path constants — normally defined by .starter; fallback for direct includes.
if (!defined ('sep'))
{
    define ('sep', DIRECTORY_SEPARATOR);
    define ('basepath', realpath (__DIR__).sep);
    define ('publicpath', realpath (basepath."public").sep);
}

foreach ($dirs as $type => $dir)
{
    if (!defined ($type))
    {
        // Root namespaces: System\, App\, Modules\ (modules are their own root).
        $nskey = substr ($type, 0, 3);
        define ($type, interlace (basepath, $dir));
        define ("ns{$nskey}", ucfirst (substr ($type, 0, -1)."\\"));
    }

    else {continue;}
}

// Structures: folder + namespace constants per tree; failure → $error='structure'.
if (!isset ($error))
{
    $structures_key = interlace (basepath, fl ('structures', false));
    if (!is_readable ($structures_key)) {$error = 'structure';}
    else {require_once $structures_key;}
}

// Kernel hand-off: require Boot.php; failure → $error='boot'.
if (!isset ($error))
{
    $boot_key = interlace (kernelf, fl ('Boot'));
    if (!is_readable ($boot_key)) {$error = 'boot';}
    else {require_once $boot_key;}
}

// Verify the class landed; failure → $error='kernel'.
if (!isset ($error))
{
    $kernel = namespacify (interlace (nskernel, 'Boot'));
    if (!class_exists ($kernel, false)) {$error = 'kernel';}
}
