<?php declare (strict_types=1);

/**
 * Bootstrap stage 2 — source roots, structures, kernel hand-off.
 *
 * Resolves the three roots (apps/, modules/, src/) with their PSR-4
 * namespace prefixes, loads `.structures`, then verifies and requires
 * the kernel Boot class.
 *
 * @since 1.0.0
 */

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

$dirs = [
    'appf'       => $application_folder ?? 'apps',
    'modulesf'   => $modules_folder ?? 'modules',
    'systemf'    => $system_folder ?? 'src',
];

unset ($call, $lock_as, $is_locked_as, $system_folder, $application_folder, $modules_folder, $debug);

if (!defined ('sep'))
{
    define ('sep', DIRECTORY_SEPARATOR);
    define ('publicpath', realpath (__FILE__).sep."public".sep);
    define ('basepath', dirname (__FILE__).sep);
}

foreach ($dirs as $type => $dir)
{
    if (!defined ($type))
    {
        // Root namespaces: System\, App\, Modules\ (modules are their own root).
        $nskey = substr ($type, 0, 3);
        define ($type, interlace (basepath, $dir));
        define ("ns{$nskey}", ucfirst (substr ($type, 0, -1)."\\"));
    }

    else {continue;}
}

include_once interlace (basepath, __f ('structures', false));
if (!defined ('modulesf') || !defined ('kernelf'))
{
    throw new Exception ("Failed to register core structures", 500);
}

$kernel_boot_key = 'Boot';

if (!is_readable (interlace (kernelf, __f ($kernel_boot_key))))
{
    throw new Exception ("Missing boot key", 404);
}

require_once interlace (kernelf, __f ($kernel_boot_key));

$kernel = namespacify (interlace (nskernel, $kernel_boot_key));
if (!class_exists ($kernel, false))
{
    throw new Exception ("Failed to prepared kernel boot sequence", 500);
}
