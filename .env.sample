# =============================================================================
# NanoRADF — Environment Configuration
# =============================================================================
# This file defines all environment-specific settings for your application.
# Values set here override the defaults in the configuration files.
# Each section below documents every available option, its purpose,
# accepted values, and any side effects.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION — Core identity & behaviour
# -----------------------------------------------------------------------------

# app.env — Current running environment.
# Controls error reporting, caching, and extension behaviour.
# Available values:
#   local   - Development machine. Full debug, verbose errors, no cache.
#   dev     - Shared development server. Same as local but with remote logs.
#   staging - Pre-production. Simulates live, errors logged not displayed.
#   prod    - Production / live. Maximum performance, no debug output.
app.env=local

# app.debug — Enable/disable detailed diagnostic output.
# When true, dump() and print() helpers work; SQL queries may be logged.
# Accepted: true | false
app.debug=true

# app.modules — Layout mode toggle for the application layer.
# Available values:
#   false - Flat apps/ layout (default when key is absent): Config/, Services/,
#           Controllers/, Model/, Views/ live directly under apps/.
#           No apps/Modules/, no Manifest.json.
#   true  - Modular apps/Modules/<Name>/ layout with the Manifest.json module
#           contract (Config/, Controllers/, Model/, Services/, Views/ per module).
# Namespace is a single PSR-4 root App\ → apps/ in both modes, mirroring folders.
# Accepted: true | false
app.modules=true

# app.mode — Framework runtime mode.
# Choose before starting an application; gates which surfaces are wired.
# Available values:
#   bone - Headless backend only: API surfaces, no SSR frontend.
#   face - Frontend (SSR) app talking to a headless backend over HTTP
#          server-to-server (never browser fetch).
#   full - Both surfaces in one codebase (default).
# Accepted: bone | face | full
app.mode=full

# app.port — Port number the dev server listens on (if using built-in server).
# Only relevant when running via `php serve` or equivalent.
# app.port=

# app.url — Base URL of the application.
# Used for link generation, asset URLs, redirects, and CORS.
# Must include the scheme (http:// or https://).
app.url=http://localhost

# app.name — Human-readable application name.
# Displayed in page titles, email subjects, and notifications.
# app.name=NanoRADF

# app.key — Application encryption key.
# Used for session data, cookie encryption, and token signing.
# Generate with: php artisan key:generate
# Format: base64:{32-byte-key}
# app.key=base64:8sH3kD9fL2pR7vX5nQ1wY4mZ6cB0gJ3tE8uA6iK9oW2rF5hN1x

# -----------------------------------------------------------------------------
# DATABASE — Connection pools
# -----------------------------------------------------------------------------
# Each connection is identified by a pool name (e.g. "default", "test").
# The system reads db.{pool}.* to build the connection config.

# --- default connection ---
# Primary database used by the application for reads and writes.

# db.default.driver — Database engine.
# Available values: mysql | pgsql | sqlite | sqlsrv
# db.default.driver=mysql

# db.default.host — Database server hostname or IP address.
# db.default.host=127.0.0.1

# db.default.port — Database server port number.
# MySQL: 3306 (usbwebserver dead) → 10019 (LocalWP)
# db.default.port=10019

# db.default.database — Database name (or path for SQLite).
# db.default.database=miniradf

# db.default.username — Username for database authentication.
# db.default.username=root

# db.default.password — Password for database authentication.
# Leave empty for no password (not recommended for production).
# db.default.password=root

# --- test connection ---
# Secondary connection, typically used for automated testing
# so tests never touch the primary database.

# db.test.driver — See db.default.driver for available values.
# db.test.driver=mysql

# db.test.host — See db.default.host.
# db.test.host=127.0.0.1

# db.test.port — Inline comment after value shows the default (3306).
# Overriding to a non-standard port avoids port conflicts.
# db.test.port=10019 # 3306

# db.test.database — Test database name. Keep separate from production DB.
# db.test.database=miniradf_test

# db.test.username — See db.default.username.
# db.test.username=root

# db.test.password — See db.default.password.
# db.test.password=root

# -----------------------------------------------------------------------------
# SESSION — User session behaviour
# -----------------------------------------------------------------------------

# session.driver — Where session data is stored.
# Available values:
#   file    - Stored in storage/framework/sessions (requires disk space).
#   cookie  - Encrypted cookie (limited to 4 KB).
#   database - Uses a dedicated sessions table.
#   redis   - In-memory via Redis (fastest, requires Redis extension).
# session.driver=file

# session.lifetime — Session idle timeout in minutes.
# After this many minutes of inactivity, the session expires.
# Recommended: 120 for web apps, 1440 (24 h) for long-running dashboards.
# session.lifetime=120

# session.cookie_secure — Set the Secure flag on the session cookie.
# Keep false for local development over HTTP (http://nanoradfw.local);
# the browser will not send a Secure cookie on a plain-HTTP origin.
# Set to true in production behind HTTPS.
# session.cookie_secure=false

# session.cookie_httponly — Set the HttpOnly flag so the cookie is not
# readable from JavaScript. Keep true.
# session.cookie_httponly=true

# session.cookie_samesite — SameSite policy for the session cookie.
# Accepted: Strict | Lax | None. Keep Strict for token-only auth.
# session.cookie_samesite=Strict

# -----------------------------------------------------------------------------
# AUTH — API token validation
# -----------------------------------------------------------------------------

# auth.token_transport — How a token reaches the headless API.
# The core reads the `Authorization: Bearer <token>` header when this is
# `bearer` (default). Register your own validator in
# `apps/Config/AuthConfig.php` to accept a different header or token source.
# Accepted: bearer | (custom via app config)
# auth.token_transport=bearer

# auth.token_header — Custom header name read when transport is not bearer.
# Only used by an application-registered validator; the core default is
# the Authorization header.
# auth.token_header=X-Auth-Token

# -----------------------------------------------------------------------------
# CACHE — Temporary data store
# -----------------------------------------------------------------------------

# cache.driver — Backend for storing cached data (views, queries, etc.).
# Available values:
#   file   - Local filesystem (storage/framework/cache).
#   redis  - In-memory via Redis.
#   apc    - APC/uopz (PHP opcode cache — CLI only).
#   array  - In-memory array (lifetime = request only; great for tests).
# cache.driver=file

# -----------------------------------------------------------------------------
# MAIL — Outbound email settings
# -----------------------------------------------------------------------------
# All values set to "null" mean the system will attempt to use defaults
# or skip mail entirely if not configured.

# mail.driver — Mail transport to use.
# Available values:
#   smtp    - Standard SMTP server.
#   sendmail - Local sendmail binary.
#   mail    - PHP's built-in mail() function.
#   log     - Write to log file instead of sending (useful for testing).
#   array   - Store in memory (discarded after request — great for tests).
# mail.driver=smtp

# mail.host — SMTP server hostname.
# mail.host=smtp.mailtrap.io

# mail.port — SMTP server port.
# 25  - Standard (often blocked by ISPs).
# 2525 - Alternative SMTP (used by Mailtrap, SendGrid, etc.).
# 587  - Submission (STARTTLS).
# 465  - SMTPS (SSL).
# mail.port=2525

# mail.username — SMTP authentication username.
# mail.username=null

# mail.password — SMTP authentication password.
# Always use environment variables for secrets — never commit real passwords.
# mail.password=null

# mail.encryption — Connection encryption protocol.
# Available values: tls | ssl | null
#   tls - STARTTLS on port 587 (most common).
#   ssl - SMTPS on port 465.
#   null - No encryption (only for local testing).
# mail.encryption=null

# mail.from.address — Default "From" address for all outgoing mail.
# If null, some drivers fall back to the first configured email in the app.
# mail.from.address=null

# mail.from.name — Default "From" name; supports variable substitution.
# Example: "${app.name}" becomes "RADFWPHP".
# mail.from.name="${app.name}"

# -----------------------------------------------------------------------------
# LOGGING — Error & event logging
# -----------------------------------------------------------------------------

# log.channel — Logging channel / handler.
# Available values:
#   stack    - Writes to multiple channels simultaneously (default).
#   single   - Single log file (storage/logs/system.log).
#   daily    - Rotates daily (storage/logs/system-YYYY-MM-DD.log).
#   syslog   - System syslog.
#   errorlog - PHP's error_log().
# log.channel=stack

# -----------------------------------------------------------------------------
# REGIONAL — Timezone & locale
# -----------------------------------------------------------------------------

# timezone — Default timezone for date/time functions.
# Accepts any PHP-supported timezone (e.g., "Asia/Jakarta", "America/New_York").
# Full list: https://www.php.net/manual/en/timezones.php
# timezone=UTC

# locale — Default application language/locale code.
# Used by translations, date formatting, and number formatting.
# Examples: en | id | ja | de | es | fr | zh-CN
# locale=en

# fallback.locale — Fallback locale when a translation key is missing
# in the primary locale.
# fallback.locale=en

# -----------------------------------------------------------------------------
# SECURITY — Hashing & encryption parameters
# -----------------------------------------------------------------------------

# bcrypt.rounds — Bcrypt hashing cost factor.
# Controls how computationally expensive password hashing is.
# Higher values = slower but more secure against brute-force attacks.
# Recommended:
#   10  - Good balance for most apps (default).
#   12  - Stronger, acceptable on modern hardware.
#   14+ - Very slow, only if security needs justify the performance hit.
# bcrypt.rounds=10
