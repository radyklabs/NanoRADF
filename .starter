<?php declare (strict_types=1);

/**
 * Starter environment — constants, dotenv, reporting, library chain.
 * --
 * Runs first in the gateway: defines version/path constants, loads
 * `.env` into the process environment, configures error reporting
 * per `app.env` / `APP_DEBUG`, then starts the `$error` sentinel
 * chain — PHP version gate ('phpmin'), `.supports` ('common'),
 * `.config` ('config') — reported by the gateway switch.
 *
 * @since 0.0.1
 */

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

// Framework version + path constants.
define ('appversion', '0.0.1');

define ('sep', DIRECTORY_SEPARATOR);

define ('publicpath', realpath (basepath.'public').sep);

/**
 * Load `.env` into the process environment.
 * --
 * Parses `KEY=VALUE` lines (skips blanks and `#` comments, strips
 * surrounding quotes and inline `#` comments) and registers each
 * entry via putenv() and $_ENV, so getenv() and genv() can read it.
 * Keys allow dots (`app.modules`); an already-set environment
 * variable wins; invalid keys are ignored. Missing `.env` is
 * skipped silently.
 *
 * @since  0.0.1
 * @return void
 */
$env_file = basepath . '.env';

if (is_file ($env_file) && is_readable ($env_file))
{
    foreach (file ($env_file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line)
    {
        $line = trim ($line);
        if ($line === '' || str_starts_with ($line, '#')) {continue;}

        $pos = strpos ($line, '=');
        if ($pos === false) {continue;}

        $key = trim (substr ($line, 0, $pos));
        if (!preg_match ('/^[A-Za-z_][A-Za-z0-9_.]*$/', $key)) {continue;}

        // First wins: never override an existing environment variable.
        if (getenv ($key) !== false) {continue;}

        $value = trim (substr ($line, $pos + 1));
        if (strlen ($value) >= 2 && ($value[0] === '"' || $value[0] === "'") && str_ends_with ($value, $value[0]))
        {
            $value = substr ($value, 1, -1);
        }

        // Strip inline comments (# …) outside quotes.
        elseif (($hash = strpos ($value, '#')) !== false)
        {
            $value = trim (substr ($value, 0, $hash));
        }

        putenv ("{$key}={$value}");
        $_ENV[$key] = $value;   // group lookup in genv() scans $_ENV
    }
}

unset ($env_file);

/** 
 * Error reporting profile.
 * --
 * With `app.debug=true`, maps `app.env` to a reporting level
 * (dev/local → full display; testing → reduced notices; else
 * silent). Without it, errors are silenced.
*/
define ('APP_DEBUG', (getenv('app.debug')==='true'));

if (APP_DEBUG)
{
    switch (getenv('app.env'))
    {
        case 'dev':
        case 'development':
        case 'local':
            error_reporting (E_ALL);
            @ini_set ('display_errors', 1);
            break;
        
        case 'testing':
        case 'staging':
            error_reporting(E_ALL & ~E_NOTICE & ~E_STRICT & ~E_USER_NOTICE);
            ini_set('display_errors', 0);
            break;

        default:
            error_reporting (0);
            @ini_set ('display_errors', 0);
            break;
    }
}

else
{
    error_reporting (0);
    @ini_set ('display_errors', 0);
}

// Minimum PHP version required by the gateway's runtime gate.
define ('PHP_MIN_VERSION', '8.1.34');

// Runtime version gate; failure → $error='phpmin'.
if (version_compare (PHP_VERSION, PHP_MIN_VERSION, "<")) {$error = 'phpmin';}

// Helper library (interlace, genv, …); failure → $error='common'.
if (!isset ($error))
{
    $common_key = call_user_func ('implode', '.', [basepath, 'supports']);
    if (!is_readable ($common_key)) {$error = 'common';}
    else {require_once $common_key;}
}

// Bootstrap config (roots, structures, kernel); failure → $error='config'.
if (!isset ($error))
{
    $configuration_key = interlace (basepath, fl ('config', false));
    if (!is_readable ($configuration_key)) {$error = 'config';}
    else {require_once $configuration_key;}
}
