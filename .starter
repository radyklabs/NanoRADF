<?php declare (strict_types=1);

/**
 * Environment bootstrap — loads configuration, sets up error handling,
 * and initializes the helper chain.
 * --
 * The foundation layer that runs before any application logic. It reads
 * `.env`, configures error display based on the environment profile,
 * enforces a minimum PHP version, and triggers the dependency chain
 * (`.supports` → `.config`) so every subsequent stage has its tools ready.
 *
 * @package     NanoRADF
 * @author      RADLabs Development Team
 * @copyright   Radlabs Studio (c) 1986 - 2026
 * @since       0.0.1
 */

namespace System;

use Throwable;

if (!defined ('basepath'))
{
    $errorcss = '/error.css';
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    if (realpath (getcwd ().$errorcss)) {echo "<link href=\"{$errorcss}\" rel=\"stylesheet\" />";}
    exit ("<notice><h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p></notice>");
}

// Framework version + path constants.
define ('appversion', '0.0.1');
define ('sep', DIRECTORY_SEPARATOR);

/**
 * Load `.env` into the process environment.
 * --
 * Parses `KEY=VALUE` lines (skips blanks and `#` comments, strips
 * surrounding quotes and inline `#` comments) and registers each
 * entry via putenv() and $_ENV, so getenv() and genv() can read it.
 * Keys allow dots (`app.modules`); an already-set environment
 * variable wins; invalid keys are ignored. Missing `.env` is
 * skipped silently.
 *
 * @since  0.0.1
 * @return void
 */
$env_file = basepath . '.env';

if (is_file ($env_file) && is_readable ($env_file))
{
    foreach (file ($env_file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line)
    {
        $line = trim ($line);
        if ($line === '' || str_starts_with ($line, '#')) {continue;}

        $pos = strpos ($line, '=');
        if ($pos === false) {continue;}

        $key = trim (substr ($line, 0, $pos));
        if (!preg_match ('/^[A-Za-z_][A-Za-z0-9_.]*$/', $key)) {continue;}

        // First wins: never override an existing environment variable.
        if (getenv ($key) !== false) {continue;}

        $value = trim (substr ($line, $pos + 1));
        if (strlen ($value) >= 2 && ($value[0] === '"' || $value[0] === "'") && str_ends_with ($value, $value[0]))
        {
            $value = substr ($value, 1, -1);
        }

        // Strip inline comments (# …) outside quotes.
        elseif (($hash = strpos ($value, '#')) !== false)
        {
            $value = trim (substr ($value, 0, $hash));
        }

        putenv ("{$key}={$value}");
        $_ENV[$key] = $value;   // group lookup in genv() scans $_ENV
    }
}

unset ($env_file);

/** 
 * Error reporting profile.
 * --
 * With `app.debug=true`, maps `app.env` to a reporting level
 * (dev/local → full display; testing → reduced notices; else
 * silent). Without it, errors are silenced.
 *
 * @since  0.0.1
 * @return bool
 */
function is_debug (): bool {return (getenv('app.debug')==='true');}

if (is_debug ())
{
    switch (getenv('app.env'))
    {
        case 'dev':
        case 'development':
        case 'local':
            error_reporting (E_ALL);
            @ini_set ('display_errors', 1);
            break;
        
        case 'testing':
        case 'staging':
            error_reporting(E_ALL & ~E_NOTICE & ~E_STRICT & ~E_USER_NOTICE);
            ini_set('display_errors', 0);
            break;

        default:
            error_reporting (0);
            @ini_set ('display_errors', 0);
            break;
    }
}

else
{
    error_reporting (0);
    @ini_set ('display_errors', 0);
}

// Minimum PHP version required by the gateway's runtime gate.
define ('PHP_MIN_VERSION', '8.1.34');

// Runtime version gate; failure → $error='phpmin'.
if (version_compare (PHP_VERSION, PHP_MIN_VERSION, "<")) {$error = 'phpmin';}

/**
 * Terminate with an error page and a log line.
 *
 * Safe to call from the gateway catch-all: never throws, and disclosure must
 * already be settled by the caller.
 *
 * @since  0.0.1
 * @param  string $message Public body message.
 * @param  int    $status  HTTP status.
 * @return void
 */
function blackwall (Throwable $th)
{
    $trace_section = '';
    $sentinel = ['starter', 'phpmin', 'common', 'config', 'structure', 'boot', 'kernel', 'helper'];
    $known    = in_array ($th->getMessage (), $sentinel, true);
    $code     = $th->getCode () !== 0 ? $th->getCode () : 500;
    $status   = ($code >= 400 && $code <= 599) ? $code : 500;

    $heading = [
        403 => 'Forbidden',
        404	=> 'Not Found',
        500	=> 'Internal Server Error',
    ][$status] ?? 'Internal System Error';

    if ($known)
    {
        $message = [
            'starter'   => 'The starter file could not be found. Please reinstall the framework.',
            'phpmin'    => 'This version of PHP is not supported. Please upgrade to a newer release.',
            'common'    => 'The common library could not be loaded. Please check the installation.',
            'config'    => 'The configuration file could not be found. Please check the installation.',
            'structure' => 'The framework directories could not be registered. Please check the installation.',
            'boot'      => 'The kernel could not be started. Please check the installation.',
            'kernel'    => 'The application could not be started. Please try again later.',
            'helper'    => 'The registered helper file could not be loaded. Please check the installation.',
        ][$th->getMessage ()];
    }
    else
    {
        if (is_debug())
        {
            $trace_section .= '<trace><ul>';
            $trace_list_format = '<li>%s</li>';

            $trace = explode ('#', $th->getTraceAsString());
            array_shift ($trace);

            foreach ($trace as $tr) {$trace_section .= sprintf ($trace_list_format, $tr);}

            $trace_section .= '</ul></trace>';

            $message = $th->getMessage ().' in '.$th->getFile ().':'.$th->getLine ();
        }

        else {$message = 'An unexpected error occurred. Please contact the Administrator.';}
    }

    $log_dir = dirname (basepath . '/storage/logs/system.log');
    if (!is_dir ($log_dir)) {@mkdir ($log_dir, 0775, true);}

    if (is_dir ($log_dir) && is_writable ($log_dir))
    {
        error_log ("[{$status}] {$message}", 3, "{$log_dir}/system.log");
    }
    else {error_log ("[{$status}] {$message}");}

    header ('Content-Type: text/html; charset=utf-8', true, $status);
    
    if (realpath (publicpath.'error.css')) {echo "<link rel=\"stylesheet\" href=\"/error.css\"/>";}
    exit ("<notice><h1>{$status} {$heading}</h1><p>{$message}</p></notice>{$trace_section}");
}

// Helper library (interlace, genv, …); failure → $error='common'.
if (!isset ($error))
{
    $common_key = call_user_func ('implode', '.', [basepath, 'supports']);
    if (!is_readable ($common_key)) {$error = 'common';}
    else {require_once $common_key;}
}

// Bootstrap config (roots, structures, kernel); failure → $error='config'.
if (!isset ($error))
{
    $configuration_key = interlace (basepath, fl ('config', false));
    if (!is_readable ($configuration_key)) {$error = 'config';}
    else {require_once $configuration_key;}
}