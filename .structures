<?php declare (strict_types=1);

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

$app_modules = (__env ('app.modules') === true);

// Path autoload root: <root>/modules when modular (D9), <root>/apps when flat.
// Namespace root mirrors it: App\Modules (modular) | App (flat).
if ($app_modules && defined ('modulesf') && is_dir (modulesf))
{
    define ('nsappmod', namespacify (interlace (nsapp, 'Modules')));
    define ('appmodf', modulesf);

    // Modular: root modules/<Name>/ with the Manifest.json module contract.
    $modulesfs = [
        'configf'       => false,
        'controllersf'  => 'nsctrl',
        'modelf'        => 'nsmodel',
        'servicesf'     => 'nsserv',
        'viewsf'        => false,
        ];

    foreach ($modulesfs as $f => $d)
    {
        $dir = ucfirst (substr ($f, 0, -1));
        $path = interlace (appmodf, '%s', $dir);

        define ($f, $path);
        if ($d !== false)
        {
            $find = 'XNsX';
            $format = str_replace ($find, '%s', namespacify (interlace (nsappmod, 'XNsX', $dir)));
            define ($d, $format);
        }
    }
}

else
{
    // Flat: apps/ is the main MVC; root modules/ is ignored (decision D9).
    define ('nsappmod', namespacify (nsapp));
    define ('appmodf', appf);
}

$systemfs = [
    'contractsf'    => 'nscont', 
    'controllersf'  => 'nsctrl', 
    'helperf'       => false, 
    'kernelf'       => 'nskernel', 
    'servicesf'     => 'nsserv', 
    'themesf'       => false, 
    'viewsf'        => false,
    ];

foreach ($systemfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -1));
    $path = interlace (systemf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);
        
        if ($d !== false)
        {
            define ($d, namespacify (interlace (nssys, $dir)));
        }
    }

    else {continue;}
    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

$viewfs = ['components', 'elements', 'errors', 'layouts', 'patterns', 'scripts', 'tokens'];
foreach ($viewfs as $f)
{
    $dir = ucfirst ($f);
    $path = interlace (viewsf, $f);
    if (is_dir ($path))
    {
        define ($f, $path);
    }

    else {continue;}
    // echo "{$f} : {$path}<br/>";
}