<?php declare (strict_types=1);

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

$appfs = [
    'configfapp'        => false,
    'controllersfapp'   => 'nsappctrl',
    'modelfapp'         => 'nsappmodel',
    'modulesfapp'       => 'nsappmod', 
    'servicesfapp'      => 'nsappserv',
    'viewsfapp'         => false,
    ];

foreach ($appfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -4));
    $path = interlace (appf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);
        
        if ($d !== false)
        {
            define ($d, namespacify (interlace (nsapp, $dir)));
        }
    }

    else {continue;}

    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

$modulesfs = [
    'configf'       => false, 
    'controllersf'  => 'nsctrl', 
    'modelf'        => 'nsmodel', 
    'servicesf'     => 'nsserv', 
    'viewsf'        => false,
    ];

foreach ($modulesfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -1));
    $path = interlace (modulesfapp, '%s', $dir);

    define ($f, $path);
    if ($d !== false)
    {
        $find = 'XNsX';
        $format = str_replace ($find, '%s', namespacify (interlace (nsappmod, 'XNsX', $dir)));
        define ($d, $format);
    }
    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

$systemfs = [
    'contractsf'    => 'nscont', 
    'controllersf'  => 'nsctrl', 
    'helperf'       => false, 
    'kernelf'       => 'nskernel', 
    'servicesf'     => 'nsserv', 
    'themesf'       => false, 
    'viewsf'        => false,
    ];

foreach ($systemfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -1));
    $path = interlace (systemf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);
        
        if ($d !== false)
        {
            define ($d, namespacify (interlace (nssys, $dir)));
        }
    }

    else {continue;}
    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

$viewfs = ['components', 'elements', 'errors', 'layouts', 'patterns', 'scripts', 'tokens'];
foreach ($viewfs as $f)
{
    $dir = ucfirst ($f);
    $path = interlace (viewsf, $f);
    if (is_dir ($path))
    {
        define ($f, $path);
    }

    else {continue;}
    // echo "{$f} : {$path}<br/>";
}