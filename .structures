<?php declare (strict_types=1);

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

// Decision D6 — layout toggle: missing/invalid app.modules → flat apps/ layout.
$app_modules = (__env ('app.modules') === true);

// Namespace autoload root: App\Modules (modular) | App (flat). Single root serves both modes.
define ('nsappmod', namespacify (interlace (nsapp, $app_modules ? 'Modules' : '')));

// Path autoload root paired with nsappmod: <root>/apps/Modules | <root>/apps.
define ('appmodf', $app_modules ? interlace (appf, 'Modules') : appf);

// Flat app folders, registered whenever they exist (both layout modes).
$appfs = [
    'configfapp'        => false,
    'controllersfapp'   => 'nsappctrl',
    'modelfapp'         => 'nsappmodel',
    'servicesfapp'      => 'nsappserv',
    'viewsfapp'         => false,
    ];

foreach ($appfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -4));
    $path = interlace (appf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);

        if ($d !== false)
        {
            define ($d, namespacify (interlace (nsapp, $dir)));
        }
    }

    else {continue;}
}

if ($app_modules)
{
    // Modular: apps/Modules/<Name>/ with the Manifest.json module contract.
    $modules_path = interlace (appf, 'Modules');
    if (is_dir ($modules_path))
    {
        define ('modulesfapp', $modules_path);
    }

    $modulesfs = [
        'configf'       => false,
        'controllersf'  => 'nsctrl',
        'modelf'        => 'nsmodel',
        'servicesf'     => 'nsserv',
        'viewsf'        => false,
        ];

    foreach ($modulesfs as $f => $d)
    {
        $dir = ucfirst (substr ($f, 0, -1));
        $path = interlace (modulesfapp, '%s', $dir);

        define ($f, $path);
        if ($d !== false)
        {
            $find = 'XNsX';
            $format = str_replace ($find, '%s', namespacify (interlace (nsappmod, 'XNsX', $dir)));
            define ($d, $format);
        }
    }
}

$systemfs = [
    'contractsf'    => 'nscont', 
    'controllersf'  => 'nsctrl', 
    'helperf'       => false, 
    'kernelf'       => 'nskernel', 
    'servicesf'     => 'nsserv', 
    'themesf'       => false, 
    'viewsf'        => false,
    ];

foreach ($systemfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -1));
    $path = interlace (systemf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);
        
        if ($d !== false)
        {
            define ($d, namespacify (interlace (nssys, $dir)));
        }
    }

    else {continue;}
    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

$viewfs = ['components', 'elements', 'errors', 'layouts', 'patterns', 'scripts', 'tokens'];
foreach ($viewfs as $f)
{
    $dir = ucfirst ($f);
    $path = interlace (viewsf, $f);
    if (is_dir ($path))
    {
        define ($f, $path);
    }

    else {continue;}
    // echo "{$f} : {$path}<br/>";
}