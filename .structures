<?php declare (strict_types=1);

/**
 * Path and namespace constants for every source tree.
 *
 * Loaded by `.config` during bootstrap. For each root that exists on disk it
 * defines the `*f` directory constant and, where mapped, the `ns*` namespace
 * constant; missing directories are skipped silently.
 *
 * @since 0.0.1
 */

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

// Application layer map (apps/): folder path + namespace per MVC role.
$appfs = [
    'configfapp'        => false,
    'controllersfapp'   => 'nsctrlapp',
    'modelfapp'         => 'nsmodelapp',
    'servicesfapp'      => 'nsservapp',
    'viewsfapp'         => false,
];
foreach ($appfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -4));
    $path = interlace (appf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);

        if ($d !== false)
        {
            define ($d, namespacify (interlace (nsapp, $dir)));
        }
    }

    else {continue;}
}

// D6/D9: app.modules=true registers the per-module folder/namespace templates
// (modules/<Name>/…). Autoload roots are always App\… → apps/, Modules\… →
// modules/; the flag gates only the template map below.
if (genv ('app.modules') === true && defined ('nsmod') && is_dir (modulesf))
{
    $modulesfs = [
        'configfmod'       => false,
        'controllersfmod'  => 'nsctrlmod',
        'modelfmod'        => 'nsmodelmod',
        'servicesfmod'     => 'nsservmod',
        'viewsfmod'        => false,
        ];

    foreach ($modulesfs as $f => $d)
    {
        $dir = ucfirst (substr ($f, 0, -4));
        $path = interlace (modulesf, '%s', $dir);

        define ($f, $path);
        if ($d !== false)
        {
            $find = 'XNsX';
            $format = str_replace ($find, '%s', namespacify (interlace (nsmod, $find, $dir)));
            define ($d, $format);
        }
    }
}

// Framework core map (src/): folder path + System\ namespace per role.
$systemfs = [
    'configf'       => false, 
    'contractsf'    => 'nscont', 
    'controllersf'  => 'nsctrl', 
    'helperf'       => false, 
    'kernelf'       => 'nskernel', 
    'servicesf'     => 'nsserv', 
    'themesf'       => false, 
    'viewsf'        => false,
    ];

foreach ($systemfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -1));
    $path = interlace (systemf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);
        
        if ($d !== false)
        {
            define ($d, namespacify (interlace (nssys, $dir)));
        }
    }

    else {continue;}
    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

// View taxonomy roles (src/Views/<role>): path constants only, no namespace.
$viewfs = ['components', 'elements', 'errors', 'layouts', 'patterns', 'scripts', 'tokens'];
foreach ($viewfs as $f)
{
    $dir = ucfirst ($f);
    $path = interlace (viewsf, $f);
    if (is_dir ($path))
    {
        define ($f, $path);
    }

    else {continue;}
    // echo "{$f} : {$path}<br/>";
}