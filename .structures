<?php declare (strict_types=1);

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

$appfs = [
    'configfapp'        => false,
    'controllersfapp'   => 'nsctrlapp',
    'modelfapp'         => 'nsmodelapp',
    'servicesfapp'      => 'nsservapp',
    'viewsfapp'         => false,
];
foreach ($appfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -4));
    $path = interlace (appf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);

        if ($d !== false)
        {
            define ($d, namespacify (interlace (nsapp, $dir)));
        }
    }

    else {continue;}
}

// Decision D6/D9 — app.modules=true registers the modular folder/namespace
// templates (modules/<Name>/…). Both roots autoload always: App\… → apps/,
// Modules\… → modules/. app.modules gates only the per-module template map.
if (__env ('app.modules') === true && defined ('nsmod') && is_dir (modulesf))
{
    $modulesfs = [
        'configfmod'       => false,
        'controllersfmod'  => 'nsctrlmod',
        'modelfmod'        => 'nsmodelmod',
        'servicesfmod'     => 'nsservmod',
        'viewsfmod'        => false,
        ];

    foreach ($modulesfs as $f => $d)
    {
        $dir = ucfirst (substr ($f, 0, -4));
        $path = interlace (modulesf, '%s', $dir);

        define ($f, $path);
        if ($d !== false)
        {
            $format = str_replace ('XNsX', '%s', namespacify (interlace (nsmod, 'XNsX', $dir)));
            define ($d, $format);
        }
    }
}

$systemfs = [
    'contractsf'    => 'nscont', 
    'controllersf'  => 'nsctrl', 
    'helperf'       => false, 
    'kernelf'       => 'nskernel', 
    'servicesf'     => 'nsserv', 
    'themesf'       => false, 
    'viewsf'        => false,
    ];

foreach ($systemfs as $f => $d)
{
    $dir = ucfirst (substr ($f, 0, -1));
    $path = interlace (systemf, $dir);

    if (is_dir ($path))
    {
        define ($f, $path);
        
        if ($d !== false)
        {
            define ($d, namespacify (interlace (nssys, $dir)));
        }
    }

    else {continue;}
    // echo "{$f} : {$path} : ".($d?constant($d):'')."<br/>";
}

$viewfs = ['components', 'elements', 'errors', 'layouts', 'patterns', 'scripts', 'tokens'];
foreach ($viewfs as $f)
{
    $dir = ucfirst ($f);
    $path = interlace (viewsf, $f);
    if (is_dir ($path))
    {
        define ($f, $path);
    }

    else {continue;}
    // echo "{$f} : {$path}<br/>";
}