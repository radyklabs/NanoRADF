<?php declare (strict_types=1);

/**
 * Global helper library — loaded first by the gateway.
 *
 * Pure functions shared across every bootstrap stage: path/namespace
 * normalisation, .env access, and HTTP utilities. Zero dependencies.
 *
 * @since 1.0.0
 */

if (!defined ('basepath'))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

/**
 * Strict equality check (`$value === $expecting`).
 *
 * @since  1.0.0
 * @param  mixed $value     The value to test.
 * @param  mixed $expecting The reference value.
 * @return bool True when strictly equal.
 */
function is (mixed $value, mixed $expecting): bool { return $value === $expecting; }


/**
 * Normalise a path or URL for web usage.
 *
 * Backslashes become forward slashes and duplicate slashes collapse;
 * the `//` in protocol schemes (http://, ftp://) is preserved.
 *
 * @since  1.0.0
 * @param  string $path Raw path or URL.
 * @return string URL-friendly path.
 */
function urlify (string $path): string
{
    // Replace backslashes with forward slashes
    $path = str_replace ('\\', '/', $path);
    // Reduce multiple slashes, but preserve protocol double-slash
    $path = preg_replace ('/(?<!:)\/{2,}/', '/', $path);
    return $path;
}

/**
 * Convert a path or identifier into a PSR-4 namespace.
 *
 * Splits on separators, strips characters invalid in a namespace
 * part, and formats each segment as PascalCase.
 *
 * @since  1.0.0
 * @param  string $string Input path or identifier.
 * @return string Namespace-formatted string.
 */
function namespacify (string $string): string
{
	// 1. Normalize separators to backslashes.
	$string = str_replace (['/', sep], '\\', $string);
	// 2. Split into segments, removing empty ones.
	$segments = array_filter (explode('\\', $string));
	// 3. Sanitize and format each segment to PascalCase.
	$cleaned_segments = array_map (function ($segment)
	{
		// Remove characters invalid in a namespace part.
		$segment = preg_replace ('/[^a-zA-Z0-9_]/', ' ', $segment);
		// Convert snake_case or kebab-case to PascalCase.
		$pascal_case = str_replace (' ', '', ucwords (str_replace (['-', '_'], ' ', $segment)));
		return $pascal_case;
	},
	$segments);
	// 4. Rejoin into a single namespace string.
	return implode ('\\', $cleaned_segments);
}

/**
 * Normalise separators to the current OS convention.
 *
 * Collapses `/` and `\` runs into DIRECTORY_SEPARATOR; UNC prefixes
 * (\\server\share) are preserved.
 *
 * @since  1.0.0
 * @param  string $path Raw path.
 * @return string Canonical OS-native path.
 */
function pathify (string $path): string
{
	$prefix = '';
	// Check for and preserve UNC path prefixes.
	if (str_starts_with ($path, '//') || str_starts_with ($path, '\\\\'))
	{
		$prefix = sep . sep;
		$path = substr ($path, 2);
	}
	// Collapse all separator types into a single, OS-specific separator.
	$normalized_path = preg_replace ('/[\\\\\/]+/', sep, $path);
	return $prefix . $normalized_path;
}

/**
 * Join path segments into one normalised path.
 *
 * Trims stray slashes, skips empty segments, then converts to the
 * OS separator — safe for filesystem and URLs.
 *
 * Example: interlace('system', 'Core', 'Boot.core') → 'system/Core/Boot.core'
 *
 * @since  1.0.0
 * @param  string ...$segments Path parts to concatenate.
 * @return string Combined path.
 */
function interlace (...$segments)
{
	$cleaned = [];

	foreach ($segments as $seg)
	{
		$seg = trim ((string) $seg, '/\\');
		if ($seg!=='') {$cleaned[] = $seg;}
	}
	
	$path = implode ('/', $cleaned);

	$first = (string) $segments[0];
	
	if (str_starts_with ($first, '/') && !str_starts_with ($path, '/'))
	{
		$path = '/' . $path;
	}

	return pathify ($path);
}

/**
 * Extract the `$directories` map from an entry file.
 *
 * Tokenizes the source, locates the `$directories = [ … ]` literal,
 * and returns its top-level `key => value` string pairs. Empty array
 * when the file is missing or holds no such array.
 *
 * @since  1.0.0
 * @param  string $file Absolute path to the entry file.
 * @return array<string, string> name => directory.
 */
function read_directories (string $file): array
{
	if (!is_file ($file)) { return []; }

	$tokens = token_get_all ((string) file_get_contents ($file));
	$count  = count ($tokens);

	for ($i = 0; $i < $count; $i++)
	{
		$token = $tokens[$i];
		if (!is_array ($token) || $token[0] !== T_VARIABLE || $token[1] !== '$directories')
		{
			continue;
		}

		// Skip trivia: expect '=' then the opening '['.
		$i++;
		while ($i < $count && is_array ($tokens[$i]) && in_array ($tokens[$i][0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) { $i++; }
		if ($i >= $count || $tokens[$i] !== '=') { continue; }

		$i++;
		while ($i < $count && is_array ($tokens[$i]) && in_array ($tokens[$i][0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) { $i++; }
		if ($i >= $count || $tokens[$i] !== '[') { continue; }

		// Collect the literal body up to the matching ']' (nested-safe).
		$depth = 0;
		$body  = '';
		for (; $i < $count; $i++)
		{
			$chunk = is_array ($tokens[$i]) ? $tokens[$i][1] : $tokens[$i];

			if ($chunk === '[') { $depth++; }
			elseif ($chunk === ']') { $depth--; if ($depth === 0) { break; } }

			if ($depth > 0) { $body .= $chunk; }
		}

		// Flat string pairs only: 'system' => 'src'.
		preg_match_all ("/['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?\s*=>\s*['\"]([^'\"]*)['\"]/", $body, $pairs, PREG_SET_ORDER);

		$map = [];
		foreach ($pairs as $pair) { $map[$pair[1]] = $pair[2]; }

		return $map;
	}

	return [];
}

/**
 * Access the $_SERVER superglobal safely.
 *
 * Entry point for request path/uri reads (Router::tryAliases). Do not
 * deprecate without a real replacement — the previously referenced
 * WordPress::server() helper does not exist in this repo.
 *
 * @param  string|null $key     Superglobal key; dots become underscores ("request.uri" → REQUEST_URI). Null returns the whole array.
 * @param  string|null $default Fallback when the key is missing.
 * @return mixed
 */
function __server (?string $args = null, ?string $default = null): mixed
{
    if (is_null ($args)) {return $_SERVER;}
    $args = strtoupper (str_replace ('.', '_', $args));
    return $_SERVER[$args] ?? $default;
}

/**
 * Cast a raw .env value to its native PHP type.
 *
 * true/false/null literals → typed value; numeric strings → int|float;
 * everything else → string as-is.
 *
 * @since  1.0.0
 * @param  string $value Raw .env value.
 * @return mixed
 */
function cast_value (string $value): mixed
{
	return match (strtolower ($value))
	{
		'true', '(true)'   => true,
		'false', '(false)' => false,
		'null', '(null)'   => null,
		default            => is_numeric ($value)
			? (str_contains ($value, '.') ? (float) $value : (int) $value)
			: $value,
	};
}

/**
 * Read a typed environment value registered by `.starter`.
 *
 * Wraps getenv() with dot-notation keys, typed casting, and a
 * fallback default. Group lookup ("app") scans process env plus
 * $_ENV (registered by `.starter`) by prefix. Requires the gateway
 * to have run `.starter` first.
 *
 * @since  1.0.0
 * @param  string $key     "app.port" for a leaf, "app" for the whole group.
 * @param  mixed  $default Fallback when the key/group is missing.
 * @return mixed Typed leaf value, group array, or $default.
 */
function __env (string $key, mixed $default = false): mixed
{
	$key = trim ($key);
	// Key must be a valid env-var name or prefix.
	if (is ($key, '') || !preg_match ('/^[a-zA-Z_][a-zA-Z0-9_.]*$/', $key)) {return $default;}

	// Leaf lookup: exact key registered by .starter via putenv().
	$value = getenv ($key);
	if (!is ($value, false)) {return cast_value ($value);}

	// Group lookup: prefix match (e.g. "app" → app.cdn.enabled, app.cdn.url).
	// getenv() no-arg omits putenv() vars, so overlay $_ENV (written by .starter).
	$prefix = $key . '.';
	$all = array_merge (getenv () ?: [], $_ENV);
	$result = [];

	foreach ($all as $k => $v)
	{
		if (str_starts_with ((string) $k, $prefix))
		{
			$result[substr ((string) $k, strlen ($prefix))] = cast_value ((string) $v);
		}
	}

	// Empty group = key genuinely missing → return $default.
	return is ($result, []) ? $default : $result;
}

/**
 * Look up the HTTP reason phrase for a status code.
 *
 * @since  1.0.0
 * @param  int $code HTTP status code.
 * @return string Reason phrase, or a generic message when unknown.
 */
function __s (int $code = 200): string
{
	return [
		100	=> 'Continue',
		101	=> 'Switching Protocols',

		200	=> 'OK',
		201	=> 'Created',
		202	=> 'Accepted',
		203	=> 'Non-Authoritative Information',
		204	=> 'No Content',
		205	=> 'Reset Content',
		206	=> 'Partial Content',

		300	=> 'Multiple Choices',
		301	=> 'Moved Permanently',
		302	=> 'Found',
		303	=> 'See Other',
		304	=> 'Not Modified',
		305	=> 'Use Proxy',
		307	=> 'Temporary Redirect',

		400	=> 'Bad Request',
		401	=> 'Unauthorized',
		402	=> 'Payment Required',
		403	=> 'Forbidden',
		404	=> 'Not Found',
		405	=> 'Method Not Allowed',
		406	=> 'Not Acceptable',
		407	=> 'Proxy Authentication Required',
		408	=> 'Request Timeout',
		409	=> 'Conflict',
		410	=> 'Gone',
		411	=> 'Length Required',
		412	=> 'Precondition Failed',
		413	=> 'Request Entity Too Large',
		414	=> 'Request-URI Too Long',
		415	=> 'Unsupported Media Type',
		416	=> 'Requested Range Not Satisfiable',
		417	=> 'Expectation Failed',
		422	=> 'Unprocessable Entity',
		426	=> 'Upgrade Required',
		428	=> 'Precondition Required',
		429	=> 'Too Many Requests',
		431	=> 'Request Header Fields Too Large',

		500	=> 'Internal Server Error',
		501	=> 'Not Implemented',
		502	=> 'Bad Gateway',
		503	=> 'Service Unavailable',
		504	=> 'Gateway Timeout',
		505	=> 'HTTP Version Not Supported',
		511	=> 'Network Authentication Required',
	][$code] ?? 'An unexpected error occurred. Please contact the Administrator.';
}

/**
 * Build a file name in the requested extension form.
 *
 * @since  1.0.0
 * @param  string      $filename Base name without extension.
 * @param  string|bool $ext      'php' → "name.php" (default), false → ".name", other → "name.ext".
 * @return string File name.
 */
function fl (string $filename, string|bool $ext = 'php'): string
{
	return [
		'php' => "{$filename}.php",
		false => ".{$filename}",
	][$ext] ?? "{$filename}.{$ext}";
}