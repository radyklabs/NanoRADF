<?php declare (strict_types=1);

use System\Kernel\Router;

/**
 * The Gateway: NanoRADF
 * --
 * Bootstrap stage 1: entry guard → constants → dotenv → helper
 * libraries → kernel hand-off, wrapped by a catch-all error path
 * that logs to storage/logs/system.log.
 *
 * @package     NanoRADF
 * @author      RADLabs Development Team
 * @copyright   Radlabs Studio (c) 1986 - 2026
 * @since       0.0.1
 */

// Entry guard: folder names must be set by public/index.php.
if (!isset ($application_folder)
    || !isset ($system_folder)
    || !isset ($modules_folder))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

/**
 * System brain: core logic
 * --
 * Bootstrap below is fragile — edits here can break the whole system.
 * Treat every change here as fragile.
 */

// $heading = 'Internal System Error';
// $message = 'An unexpected error occurred. Please contact the Administrator.';

define ('basepath', realpath (__DIR__).DIRECTORY_SEPARATOR);

$starter_key = call_user_func ('implode', '.', [basepath, 'starter']);
if (!is_readable ($starter_key)) {$error = 'starter';}
else {require_once $starter_key;}

try
    {
        if (isset ($error)) {throw new Exception ($error, 500);}
        unset ($error);
        call_user_func ([$kernel, 'initiate']);

        // Dispatch on web SAPIs; CLI stays a plain loader so tests/smoke_check.php
        // loads without resolving routes.
        if ($debug === true || php_sapi_name () !== 'cli')
        {
            $method     = strtoupper ((string) gserver ('request.method', 'GET'));
            $actionPath = Router::normalise ((string) gserver ('request.uri', '/'));

            try
            {
                $response = Router::dispatch ($method, $actionPath);

                            // Surface-specific headers (e.g. application/json on api) are
                            // enforced here, before the status line goes out.
                            $headers = (array) ($response['headers'] ?? []);
                            $isJson = in_array ('Content-Type: application/json; charset=utf-8', $headers, true);

                            if ($isJson)
                            {
                                header ('Content-Type: application/json; charset=utf-8', true, (int) ($response['status'] ?? 200));
                            }
                            else
                            {
                                foreach ($headers as $line)
                                {
                                    header ((string) $line);
                                }

                                header ('Content-Type: text/html; charset=utf-8', true, (int) ($response['status'] ?? 200));
                            }

                echo (string) ($response['body'] ?? '');
            }

            catch (Throwable $th)
            {
                // Runtime fault: honour the $debug gate (FR-10).
                $message = $th->getMessage ().' in '.$th->getFile ().':'.$th->getLine ();
                header ('Content-Type: text/html; charset=utf-8', true, 500);
                exit ('<h1>500 Internal Server Error</h1><p>'
                    .htmlspecialchars ($debug === true ? $message : 'An unexpected error occurred.', ENT_QUOTES).'</p>');
            }
        }
    }

// Catch-all: map the code to a heading, log file:line, emit the body.
catch (Throwable $th)
{
    // Bootstrap sentinels carry a code and a friendly phrase; runtime faults
    // (router/controller) fall through to the generic message.
    $sentinel = ['starter', 'phpmin', 'common', 'config', 'structure', 'boot', 'kernel'];
    $known    = in_array ($th->getMessage (), $sentinel, true);
        $code     = $th->getCode () !== 0 ? $th->getCode () : 500;

        // The dispatch block has its own catch so only bootstrap faults land here.
        if (!$known)
        {
            header ('Content-Type: text/html; charset=utf-8', true, $code >= 400 && $code <= 599 ? $code : 500);
            exit ('<h1>500 Internal Server Error</h1><p>'.htmlspecialchars ($th->getMessage ().' in '.$th->getFile ().':'.$th->getLine (), ENT_QUOTES).'</p>');
        }

    // Runtime faults (router/controller) get the generic message + status unless
    // $debug reveals detail.
    $status = $known ? 500 : ($code >= 400 && $code <= 599 ? $code : 500);

    $heading = [
        403 => 'Forbidden',
        404	=> 'Not Found',
        500	=> 'Internal Server Error',
    ][$status] ?? 'Internal System Error';

    $message = [
        'starter'   => 'The starter file could not be found. Please reinstall the framework.',
        'phpmin'    => 'This version of PHP is not supported. Please upgrade to a newer release.',
        'common'    => 'The helper library could not be loaded. Please check the installation.',
        'config'    => 'The configuration file could not be found. Please check the installation.',
        'structure' => 'The framework directories could not be registered. Please check the installation.',
        'boot'      => 'The kernel could not be started. Please check the installation.',
        'kernel'    => 'The application could not be started. Please try again later.',
    ][$th->getMessage ()] ?? 'An unexpected error occurred. Please contact the Administrator.';

    if ($debug === true && !$known)
    {
        $message = "{$message} in {$th->getFile ()}:{$th->getLine ()} ({$th->getMessage ()})";
    }

    $log_dir = dirname (basepath . '/storage/logs/system.log');
    if (!is_dir ($log_dir)) {@mkdir ($log_dir, 0775, true);}

// Never reveal internals unless $debug says so; the exception's own text is
    // safe only under that gate.
    if (is_dir ($log_dir) && is_writable ($log_dir))
    {
        error_log ("[{$status}] {$message}", 3, "{$log_dir}/system.log");
    }
    else {error_log ("[{$status}] {$message}");}

    // http_response_code ($code);
    header ('Content-Type: text/html; charset=utf-8', true, $status);
    exit ("<h1>{$status} {$heading}</h1><p>{$message}</p>");
}
