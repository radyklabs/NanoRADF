<?php declare (strict_types=1);

/**
 * The Gateway: NanoRADF
 * --
 * Bootstrap entry point — validates configuration, loads environment settings, resolves helpers
 * and kernel, then dispatches the request. Every bootstrap failure funnels through a single
 * safe error handler that writes to `storage/logs/system.log`.
 *
 * @package     NanoRADF
 * @author      RADLabs Development Team
 * @copyright   Radlabs Studio (c) 1986 - 2026
 * @since       0.0.1
 */

namespace System;

use Exception;
use Throwable;
use System\Kernel\Dispatcher;

// Entry guard: folder names must be set by public/index.php.
if (!isset ($application_folder)
    || !isset ($system_folder)
    || !isset ($modules_folder))
{
    try {exit (@require realpath (__DIR__).DIRECTORY_SEPARATOR.'.errorss');}
    catch (Throwable $e) {$file = basename (__FILE__); exit ("404 Forbidden {$file}");}
}

define ('publicpath', realpath (getcwd ()).DIRECTORY_SEPARATOR);
define ('basepath', realpath (__DIR__).DIRECTORY_SEPARATOR);

$starter_key = call_user_func ('implode', '.', [basepath, 'starter']);
if (!is_readable ($starter_key)) {$error = 'starter';}
else {require_once $starter_key;}

try
{
    // throw new Exception ('jancuk', 500);
    if (isset ($error)) {throw new Exception ($error, 500);}
    unset ($error, $starter_key);

    call_user_func ([$kernel, $init]);
    unset ($kernel, $init);

    // Dispatch on web SAPIs; CLI stays a plain loader so tests/smoke_check.php
    // loads without resolving routes.
    if (php_sapi_name () !== 'cli') {Dispatcher::handle ();}
}

// Catch-all: friendly text for bootstrap sentinels, generic/gated text otherwise,
// plus the storage/logs/system.log entry.
catch (Throwable $th)
{
    if (function_exists (__NAMESPACE__.'\blackwall')) {blackwall ($th);}
    else {require realpath (__DIR__).DIRECTORY_SEPARATOR.'.errors';}
}
