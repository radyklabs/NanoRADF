<?php declare (strict_types=1);

if (!isset ($application_folder)
    || !isset ($system_folder)
    || !isset ($modules_folder))
{
    http_response_code (404);
    header ('Content-Type: text/html; charset=utf-8');
    exit ("<h1>404 Not Found</h1><p>The requested page (or file) could not be found.</p>");
}

// Stop editing. Leave code below, it's fragile to the system.
// These messages are visible only if the framework cannot load at all.
$heading = 'Internal System Error';
$message = 'An unexpected error occurred. Please contact the Administrator.';

define ('sep', DIRECTORY_SEPARATOR);
define ('publicpath', realpath (__DIR__).sep);
define ('basepath', dirname (__DIR__).sep);
define ('isdebug', (isset ($debug) && $debug===true));

try
{
    $common_key = 'supports';

    if (!is_readable (call_user_func ('implode', '.', [basepath, $common_key])))
    {
        throw new Exception ("Where the hell did you put the common key?!", 404);
    }

    require_once call_user_func ('implode', '.', [basepath, $common_key]);

    if (!is_callable ('interlace'))
    {
        throw new Exception ("Failed to call supports library", 500);
    }

    $configuration_key = 'config';

    if (isdebug)
    {
        error_reporting (E_ALL);
        @ini_set ('display_errors', 1);
    }

    else
    {
        error_reporting (0);
        @ini_set ('display_errors', 0);
    }

    if (!is_readable (interlace (basepath, __f ($configuration_key, false))))
    {
        throw new Exception ('Configuration key is missing', 404);
    }

    require_once interlace (basepath, __f ($configuration_key, false));

    if (isset ($kernel) && class_exists ($kernel))
    {
        call_user_func ([$kernel, 'initiate']);
    }

    else {throw new Exception ('Kernel not booting up', 500);}
}
catch (Throwable $th)
{
    $status = [
		404	=> 'Not Found',
		500	=> 'Internal Server Error',
    ][$th->getCode()] ?? 'Internal System Error';

    $code = $th->getCode() ?: 500;
    $message = $th->getMessage () . ' in ' . $th->getFile () . ':' . $th->getLine ();

    // Explicit destination: <root>/storage/logs/system.log (portable, NFR-5).
    // mode 3 = append; if the dir can't be made writable, error_log() without
    // a path falls back to PHP's default log (silent).
    $log_dir = dirname (basepath . '/storage/logs/system.log');
    if (!is_dir ($log_dir)) {@mkdir ($log_dir, 0775, true);}

    if (is_dir ($log_dir) && is_writable ($log_dir))
    {
        error_log ("[{$code}] {$message}", 3, "{$log_dir}/system.log");
    }
    else
    {
        error_log ("[{$code}] {$message}");
    }

    http_response_code ($code);
    header ('Content-Type: text/html; charset=utf-8');

    exit ("<h1>{$heading}</h1><p>{$message}</p>");
}
